{
  "name": "napster-web",
  "private": true,
  "version": "2.0.10-3",
  "type": "module",
  "description": "Web recreation of Napster v2.0 BETA 10.3 with a zero-native in-browser TCP/OpenNap bridge.",
  "scripts": {
    "dev": "vite build && vite preview --host 0.0.0.0 --port 43179 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 43179 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
